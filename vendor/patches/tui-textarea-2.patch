+        pushed(&mut history, 'a', 0, start);
+        let mark = history.mark();
+        pushed(&mut history, 'b', 1, start);
+        pushed(&mut history, 'c', 2, start);
+        history.group_since(mark, None, start);
+        lines[0] = "abc".into();
+
+        history.undo(&mut lines);
+        assert_eq!(lines[0], "a");
+        history.undo(&mut lines);
+        assert_eq!(lines[0], "");
+        history.redo(&mut lines);
