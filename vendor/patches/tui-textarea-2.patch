+        assert_eq!(segments("aaaa \"bbbb cc", WrapMode::Word, 7), vec!["aaaa ", "\"bbbb ", "cc"]);
+        assert_eq!(segments("aaaa (bbbb). cc", WrapMode::Word, 7), vec!["aaaa ", "(bbbb). ", "cc"]);
+        assert_eq!(segments("aaaa [bbbb] cc", WrapMode::Word, 7), vec!["aaaa ", "[bbbb] ", "cc"]);
+        assert_eq!(segments("aaaa bbbb! cc", WrapMode::Word, 7), vec!["aaaa ", "bbbb! ", "cc"]);
+        assert_eq!(segments("aaaa bbbb? cc", WrapMode::Word, 7), vec!["aaaa ", "bbbb? ", "cc"]);
+        assert_eq!(segments("aaaa bbbb: cc", WrapMode::Word, 7), vec!["aaaa ", "bbbb: ", "cc"]);
+        assert_eq!(segments("aaaa bbbb; cc", WrapMode::Word, 7), vec!["aaaa ", "bbbb; ", "cc"]);
+    }
+
