# ── Image & Host Data Directory ───────────────────────────────────────────────
TCT_IMAGE_TAG=latest
# Point this to your synced tct data directory on the host (e.g., ~/.tct or a Syncthing/Dropbox folder)
TCT_HOST_DATA_DIR=./data
TCT_PORT=4180
TCT_ARGS=

# ── OAuth2 Proxy Configuration ────────────────────────────────────────────────
# Supported providers: github, google, oidc, gitlab, etc.
# Docs: https://oauth2-proxy.github.io/oauth2-proxy/configuration/providers/
OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_CLIENT_ID=your-oauth-client-id
OAUTH2_PROXY_CLIENT_SECRET=your-oauth-client-secret

# Generate a 32-byte base64url secret with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64url-secret

# Set to false ONLY when testing over plain http://localhost without TLS
OAUTH2_PROXY_COOKIE_SECURE=true

# Public callback URL registered with your OAuth provider
OAUTH2_PROXY_REDIRECT_URL=https://tct.example.com/oauth2/callback

# Restrict who can log in (important for personal use!):
# For GitHub: comma-separated GitHub usernames
OAUTH2_PROXY_GITHUB_USERS=your-github-username
# Or restrict by email domain (default * when using OAUTH2_PROXY_GITHUB_USERS)
OAUTH2_PROXY_EMAIL_DOMAINS=*

# If using generic OIDC (Pocket ID, Authelia, Authentik, Keycloak, etc.):
# OAUTH2_PROXY_PROVIDER=oidc
# OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com
